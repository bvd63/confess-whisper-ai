{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"types": ["vitest/globals", "vite/client", "node"],
		"jsx": "react-jsx",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"allowJs": true,
		"composite": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"downlevelIteration": true
	},
	"include": [
		"tests/**/*.ts",
		"tests/**/*.tsx",
		"scripts/**/*.ts"
	]
}
