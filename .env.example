# ============================================
# REQUIRED - App will not start without these
# ============================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# ============================================
# OPTIONAL - Features work with reduced functionality if missing
# ============================================

# Stripe VIP Subscriptions (required for premium features)
VITE_STRIPE_PRICE_VIP_MONTH_ID=price_...
VITE_STRIPE_PRICE_VIP_YEAR_ID=price_...

# OneSignal Push Notifications (required for push notifications)
VITE_ONESIGNAL_APP_ID=your-onesignal-app-id

# Sentry Error Tracking (optional - for production monitoring)
VITE_SENTRY_DSN=https://...@sentry.io/...

# Cloudflare Turnstile (optional - for CAPTCHA)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ============================================
# APP ENVIRONMENT
# ============================================
MODE=development
