VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Stripe Configuration (get from https://dashboard.stripe.com/test/apikeys)
# Test mode: pk_test_...
# Production: pk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=

# Cloudflare Turnstile CAPTCHA (get from https://dash.cloudflare.com/turnstile)
# Optional - if not set, a test key will be used (always passes)
# Production requires your own key for security
VITE_TURNSTILE_SITE_KEY=

# Mapbox Token (optional, for location features)
# Get from https://account.mapbox.com/access-tokens/
# If not set, location picker will use a fallback token
VITE_MAPBOX_TOKEN=
