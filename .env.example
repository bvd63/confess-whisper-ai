# Supabase Configuration (Public - safe to commit)
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_anon_public_key"
VITE_SUPABASE_URL="https://your_project.supabase.co"

# Cloudflare Turnstile (Public site key - safe to commit)
VITE_TURNSTILE_SITE_KEY="your_turnstile_site_key"

# Stripe Configuration (REQUIRED in production - set in .env.local)
VITE_STRIPE_PRICE_VIP_MONTH_ID=""
VITE_STRIPE_PRICE_VIP_YEAR_ID=""

# OneSignal Configuration (OPTIONAL - set in .env.local if using push notifications)
VITE_ONESIGNAL_APP_ID=""
