# Supabase Configuration (Public - safe to commit)
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_anon_public_key"
VITE_SUPABASE_URL="https://your_project.supabase.co"

# Cloudflare Turnstile (Public site key - safe to commit)
VITE_TURNSTILE_SITE_KEY="your_turnstile_site_key"

# Stripe Configuration (REQUIRED in production - set in .env.local)
VITE_STRIPE_PRICE_VIP_MONTHLY=""
VITE_STRIPE_PRICE_VIP_YEARLY=""

# OneSignal Configuration (OPTIONAL - set in .env.local if using push notifications)
VITE_ONESIGNAL_APP_ID=""

# Feature Flags (toggle advanced functionality)
VITE_FEATURE_PASSWORDLESS="false"
VITE_FEATURE_OFFLINE_QUEUE="false"
VITE_FEATURE_BACKGROUND_QUEUE="false"
VITE_FEATURE_PWA_PROMPT="true"
VITE_FEATURE_PROFILE_MINI_ANALYTICS="true"

# Optional Monitoring / Sharing
VITE_SENTRY_DSN=""
VITE_WEB_SHARE_ENABLED="true"

# Security Toggles
VITE_CONFESSION_TURNSTILE_REQUIRED="true"

# Backend-only secrets (set in .env.local or platform secrets)
# TURNSTILE_SECRET=""
# STRIPE_WEBHOOK_SECRET=""
# SUPABASE_SERVICE_ROLE_KEY=""
# STRIPE_SECRET_KEY=""
# STRIPE_PRICE_VIP_MONTHLY=""
# STRIPE_PRICE_VIP_YEARLY=""
# ONESIGNAL_REST_API_KEY=""
